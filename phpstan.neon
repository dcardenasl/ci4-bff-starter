parameters:
    level: 8
    paths:
        - app/Controllers
        - app/Libraries
        - app/Filters
    parallel:
        jobSize: 20
        processTimeout: 600.0
        maximumNumberOfProcesses: 0
        minimumNumberOfJobsPerProcess: 2
        buffer: 134217728
    excludePaths:
        - vendor
        - writable
        - tests/_support (?)
        - app/Config
        - app/Views
        - app/Commands
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        # CI4 helper functions (loaded globally via spark/autoloader)
        - '#Function (esc|lang|service|helper|model|config|cache|view|is_cli|env|base_url|site_url|redirect|clean_path|log_message|old|cli|session|csrf_token|csrf_hash|csrf_field|csrf_meta|password_strength) not found#'
        # CI4 framework constants
        - '#Constant (APPPATH|FCPATH|ROOTPATH|WRITEPATH|ENVIRONMENT) not found#'
        # CI4 controller magic methods (request, response, etc.)
        - '#Call to an undefined method App\\Controllers\\.*::(request|response|getVarString|getGetString|getVarInt|respondForbidden)\(\)#'
        # Generic object access — appears when a service returns mixed-shape
        # untyped data; should be progressively typed but not blocking.
        - '#Call to an undefined method object::#'
        - '#Access to an undefined property object::#'
